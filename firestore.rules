rules_version = '2';

// Data model (see firestore.indexes.json):
//   /users/{uid}              — SE profile: displayName, region, OTE, quotas, fx, onboarded
//   /aePools/{poolId}         — legacy per-SE AE pool: seUid, quarter, aes[]
//   /regionPools/{region_q}   — per-region AE pool from BigQuery (USD): aes[], totalCwUSD
//   /regionConfig/{region}    — per-region team quotas (USD), admin-editable
//   /syncLog/latest           — last BigQuery sync summary
//
// Auth: Firebase Google SSO — request.auth.uid is the Firebase UID,
//       request.auth.token.email is the verified Google email.
//
// Admins/leaders can read all data (Team View). regionPools are written only
// by the Cloud Function (admin SDK, bypasses rules).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in [
            'brad.towers@simprogroup.com',
            'thilo.schatz@simprogroup.com',
            'thilo.schatz@simpro.us'
          ];
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── User profiles ──────────────────────────────────────────────────────
    // Each SE owns exactly one document keyed by their Firebase UID.
    // Admin can read any profile for Team View.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false; // profiles are never deleted via the app
    }

    // ── Sync log (written by Cloud Functions, readable by admins) ──────────
    match /syncLog/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Region pools (written by Cloud Function from BigQuery) ─────────────
    // Real Closed Won per region, in USD. Any signed-in user may read; only
    // the Cloud Function (admin SDK) writes.
    match /regionPools/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── Region config (per-region team quotas, USD) ────────────────────────
    // Any signed-in user may read; only admins edit quotas.
    match /regionConfig/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── AE pools ───────────────────────────────────────────────────────────
    // Each document carries a seUid field identifying the owning SE.
    // Admin can read all pools for Team View aggregation.
    match /aePools/{poolId} {
      allow read:   if isAdmin()
                    || (isSignedIn() && resource.data.seUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.seUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.seUid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.seUid == request.auth.uid;
    }

  }
}
